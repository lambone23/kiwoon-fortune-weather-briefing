# ── OpenAI 호환 LLM API ──
# 사주 해석 텍스트를 생성하는 데 사용 (계산이 아니라 서술만 담당)
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://mlapi.run/ec6741df-87b6-4eb2-8db5-142337cd29a8/v1
# 사용할 모델명. 다른 모델로 교체 시 코드 수정 없이 이 값만 변경하면 됨
# (로컬 .env / Render 환경변수 둘 다 동일하게 반영 필요)
OPENAI_MODEL=gpt-5-mini

# ── DB (NeonDB / PostgreSQL) ──
# 구독자 정보(subscribers 테이블)를 저장하는 DB 연결 문자열
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── 이메일 발송 (Brevo API) ──
# Gmail SMTP 대신 사용. Render Free 플랜이 SMTP 포트(25/465/587)를
# 차단하고 있어, HTTPS 기반 API로 전환함 (Part 7)
BREVO_API_KEY=your_brevo_api_key_here
# Brevo에 발신자로 등록·인증 완료된 이메일 주소만 사용 가능
BREVO_SENDER_EMAIL=your_verified_sender@example.com

# ── 프론트엔드 배포 주소 ──
# 이메일 속 관리 링크(manage_link) 조립에 사용됨
# 로컬 개발 시: http://localhost:3000
# 배포 시: 실제 Vercel 도메인(예: https://kiwoon.vercel.app)으로 교체 필수
BASE_URL=http://localhost:3000

# ── CORS 허용 출처 ──
# 프론트엔드에서 백엔드 API로 요청을 보낼 수 있도록 허용할 출처(origin)
# 여러 개일 경우 쉼표로 구분 (예: http://localhost:3000,https://kiwoon.vercel.app)
# 배포 시 실제 Vercel 도메인 추가 필수 — 누락 시 CORS 에러 발생
FRONTEND_ORIGINS=http://localhost:3000

# ── 기상청 날씨 API ──
# 지역별 오늘 날씨(단기예보 + 초단기예보) 조회에 사용 (Part 3)
WEATHER_API_KEY=your_weather_api_key_here
WEATHER_BASE_URL=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0

# ── 외부 크론 인증 ──
# 외부 Cron(cron-job.org)이 /cron/send-fortunes 호출 시 사용하는 인증값
# X-Cron-Secret 헤더로 전달됨 (URL 쿼리 파라미터 방식은 로그 노출 위험으로 폐기, Part 7-4)
# 충분히 길고 예측 불가능한 랜덤 문자열로 설정할 것
# (예: python -c "import secrets; print(secrets.token_urlsafe(32))")
CRON_SECRET=your_cron_secret_here