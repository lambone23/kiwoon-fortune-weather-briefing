OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://mlapi.run/ec6741df-87b6-4eb2-8db5-142337cd29a8/v1

DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

SMTP_EMAIL=your_email@gmail.com
SMTP_APP_PASSWORD=your_app_password_here

# 프론트엔드 배포 주소 — 이메일 속 관리 링크(manage_link) 조립에 사용됨
# 로컬 개발 시: http://localhost:3000
# 배포 시: 실제 Vercel 도메인(예: https://kiwoon.vercel.app)으로 교체 필수
BASE_URL=http://localhost:3000

# 추후 단계 (날씨/음양력 API 연동 시 사용)
WEATHER_API_KEY=your_weather_api_key_here
WEATHER_BASE_URL=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0

# 외부 Cron(cron-job.org)이 /cron/send-fortunes 호출 시 인증에 사용하는 비밀값.
# 충분히 길고 예측 불가능한 랜덤 문자열로 설정할 것 (예: python -c "import secrets; print(secrets.token_urlsafe(32))")
CRON_SECRET=your_cron_secret_here